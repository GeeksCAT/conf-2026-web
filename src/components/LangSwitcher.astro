---
import type { Locale } from '../i18n/ui';
import { getAlternateLocales, getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);
const alternates = getAlternateLocales(Astro.url.pathname, locale);

const langNames: Record<Locale, string> = {
  ca: 'Català',
  en: 'English',
  es: 'Español',
};
---

<div role="group" aria-label={t('lang.switcher.aria')} class="flex items-center font-mono text-xs uppercase tracking-widest">
  {alternates.map(({ locale: l, href, isCurrent }, i) => (
    <>
      {i > 0 && <span class="text-outline-variant mx-0.5" aria-hidden="true">/</span>}
      <a
        href={href}
        hreflang={l}
        lang={l}
        aria-label={langNames[l]}
        aria-current={isCurrent ? 'page' : undefined}
        class={isCurrent
          ? 'text-primary-container font-bold'
          : 'text-on-surface-variant hover:text-on-surface transition-colors duration-150'}
      >
        {l.toUpperCase()}
      </a>
    </>
  ))}
</div>
