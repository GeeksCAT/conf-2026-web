---
import '../styles/global.css';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { getLocale, useTranslations } from '../i18n/utils';
export { getStaticPaths } from '../i18n/utils';

const locale = getLocale(Astro.params.lang);
const t = useTranslations(locale);

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: {
    path: string,
    width: number,
    height: number,
  };
}

const {
  title,
  description = 'La conferència de geeks per a geeks de Catalunya.',
  canonical,
  ogImage = {
    path: '/geekscatconf-2026-social-media.png',
    width: 1200,
    height: 634,
  },
} = Astro.props;

const siteUrl = 'https://conf.geeks.cat';
const canonicalUrl = canonical ?? `${siteUrl}${Astro.url.pathname}`;
const fullTitle = title === '' ? 'GEEKSCAT CONF 2026' : `${title} · GEEKSCAT CONF 2026`;
---

<!doctype html>
<html lang={Astro.currentLocale ?? 'ca'} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Anti-FOUC: apply theme before first paint -->
    <script is:inline>
      (function () {
        var t = localStorage.getItem('theme');
        var m = matchMedia('(prefers-color-scheme:light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t || m;
      })();
    </script>

    <!-- SEO -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {ogImage && <meta property="og:image" content={`${siteUrl}${ogImage.path}`} />}
    {ogImage && <meta property="og:image:width" content={String(ogImage.width)} />}
    {ogImage && <meta property="og:image:height" content={String(ogImage.height)} />}
    {ogImage && <meta property="og:image:alt" content={t('ogImage.alt')} />}
    {ogImage && <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />}

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/>
    <link rel="manifest" href="/site.webmanifest"/>

    <!-- Preload critical font (Space Grotesk variable, used in headings/nav) -->
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary-container focus:text-on-primary focus:font-mono focus:text-code-sm">
      Saltar al contingut principal
    </a>
    <Nav />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
