---
import BaseLayout from '../components/BaseLayout.astro';
import CTAButton from '../components/CTAButton.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { getLocale, useTranslations } from '../i18n/utils';

const locale = getLocale(Astro.currentLocale);
const t = useTranslations(locale);

const topics = [
  {
    index: '1',
    name: 'Open Source',
    accent: 'primary-container',
    topics: ['Contribucions a projectes', 'Governança de comunitats', 'Llicències i sostenibilitat', 'Casos d\'èxit locals'],
  },
  {
    index: '2',
    name: 'Dev, Ops, SRE ...',
    accent: 'secondary-container',
    topics: ['Arquitectures modernes', 'Rendiment i Core Web Vitals', 'Observabilitat i SLOs', 'CI/CD i GitOps', 'Kubernetes i plataformes'],
  },
  {
    index: '3',
    name: 'AI & Data',
    accent: 'primary-fixed-dim',
    topics: ['LLMs en producció', 'MLOps i pipelines', 'IA responsable', 'Casos d\'ús reals'],
  },
  {
    index: '4',
    name: 'Lideratge',
    accent: 'secondary-fixed-dim',
    topics: ["Lideratge d'equips tècnics", 'Direcció tècnica'],
  },
] as const;

const formats = [
  { label: 'XERRADA', duration: '40 min + 15 min per preguntes', description: 'Format principal. Xerrada tècnica completa amb temps per a preguntes.' },
  { label: 'LIGHTNING TALK', duration: '10 min + 10 mins per preguntes', description: 'Presentació ràpida d\'una idea, eina o experiment. Alt impacte, baix temps.' },
  { label: 'TALLER', duration: '120 min <= X <= 180 min', description: 'Sessió pràctica amb participants. Requereix proposta detallada.' },
] as const;

const gratificacions = [
  'Entrada gratuïta completa a la conferència',
  'Assortiment de cortesia',
  'Descompte del 50% en la primers quota de sòcia de GeeksCAT (vàlid fins al 26 de novembre del 2026) ',
  'Sopar exclusiu de per ponents i organitzadors',
  'Possible subvenció per desplaçament, estancia i dietes (pressupost limitat)',
] as const;
---

<BaseLayout
    title="t('cfp.title')"
  description="Presenta la teva xerrada a GeeksCAT Conf 2026. CFP obert fins al 31 d'agost de 2026."
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <header class="relative pt-32 pb-20 px-6 overflow-hidden">
    <div class="absolute inset-0 grid-lines opacity-10 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-5xl mx-auto relative z-10">
      <span class="font-mono text-code-sm text-primary-container uppercase tracking-widest block mb-6 uppercase">
        [ CFP_STATUS: {t('speakers.cfp-status')} ]
      </span>
      <h1 class="font-display uppercase tracking-tighter mb-4 leading-none"
          style="font-size: clamp(2.5rem, 8vw, 5rem)">
        {t('cfp.headline')}
      </h1>
      <p class="font-body text-body-lg text-on-surface-variant mb-8 max-w-xl">
        Tens un projecte, una experiència o una idea que val la pena compartir i inspirar la comunitat tècnica catalana? Presenta la teva xerrada a GeeksCAT Conf 2026.
      </p>
      <div class="flex flex-wrap gap-4 items-center">
        <span class="font-mono text-code-sm border-2 border-primary-container text-primary-container px-5 py-2 uppercase">
          DEADLINE: {t('cfp.deadline')}
        </span>
        <span class="font-mono text-code-sm text-on-surface-variant border border-outline-variant px-5 py-2 uppercase">
          IDIOMES: CAT / ENG / ESP
        </span>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════
       PRESENTA LA TEVA XERRADA
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low border-t border-outline-variant" aria-labelledby="present-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag="QUÈ BUSQUEM" title="PRESENTA LA TEVA XERRADA" />

      <div class="grid lg:grid-cols-2 gap-16">
        <div class="space-y-5">
          <p class="font-body text-body-lg text-on-surface leading-relaxed">
            No busquem presentacions corporatives. Busquem profunditat tècnica, lideratge, "live coding" arriscat, arquitectures complexes i històries de guerra reals. Si el teu codi fa coses increïbles (o ha explotat de forma èpica).
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            Geeks apassionats per compartir coneixement sobre qualsevol aspecte tècnic (Arquitectura i Enginyeria de Programari / Sistemes, SRE, AI & Data, ...), i si hi ha Open Source, encara millor. No cal que tinguis experiència, només ganes.
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            L'aspecte tècnic no ho és tot, el seu lideratge i inspiracions també, per tant, si líderes un equip tècnic o saps com inspirar la comunitat catalana per impulsar el seu talent o fer ús conscient de la tecnologia, aquesta és la teva conferencia.
          </p>
        </div>

        <div class="space-y-6">
          <div>
            <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-4">[ CRITERIS ]</p>
            <ul class="space-y-3 list-none">
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">Profunditat</strong> — volem entrar fins al fons del "kernel"</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">Experiència</strong> — basat en el que has viscut, provat o construït</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">Cultura Geek</strong> — passió per la tecnologia, eperit hacker</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">Diversitat</strong> — perspectives diverses, temàtiques variades, nivells mixtos</span>
              </li>
            </ul>
          </div>

          <div class="border-t border-outline-variant pt-6">
            <p class="font-mono text-code-sm text-outline uppercase tracking-widest mb-2">// NO ACCEPTEM</p>
            <p class="font-body text-body-md text-outline">Presentacions de productes comercials ni demos de vendes.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FORMATS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6" aria-labelledby="formats-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag="FORMATS" title="TRIA EL TEU FORMAT" />

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {formats.map(({ label, duration, description }) => (
          <div class="bg-surface-container border border-outline-variant p-8 flex flex-col gap-4">
            <div>
              <p class="font-display text-headline-md uppercase tracking-tight mb-1">{label}</p>
              <span class="font-mono text-code-sm text-primary-container border border-primary-container/30 px-3 py-1 inline-block">
                {duration}
              </span>
            </div>
            <p class="font-body text-body-md text-on-surface-variant leading-relaxed flex-1">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       TOPICS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag="ALGUNES DE LES ÀREES TEMÀTIQUES PROPOSADES" title="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {topics.map(({ index, name, accent, topics }) => (
          <article class={`bg-surface-container border-l-4 border-${accent} p-8`}>
            <p class={`font-mono text-code-sm text-${accent} uppercase tracking-widest mb-4`}>{index}</p>
            <h3 class="font-display text-headline-md uppercase tracking-tight mb-5">{name}</h3>
            <ul class="space-y-2 list-none">
              {topics.map((topic) => (
                <li class="flex gap-3 items-start">
                  <span class={`text-${accent} font-mono text-code-sm mt-0.5 shrink-0`} aria-hidden="true">·</span>
                  <span class="font-body text-body-md text-on-surface-variant">{topic}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="font-body text-body-md text-on-surface-variant mt-8 text-center">
        Les àrees temàtiques són merament una proposa, davant del dubte, presenta la teva xerrada
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       GRATIFICACIONS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6" aria-labelledby="gratificacions-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag="PER ALS PONENTS" title="GRATIFICACIONS" />

      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <ul class="space-y-4 list-none">
          {gratificacions.map((item) => (
            <li class="flex gap-4 items-start border-b border-outline-variant/40 pb-4 last:border-0 last:pb-0">
              <span class="text-secondary-container font-mono text-code-sm mt-0.5 shrink-0" aria-hidden="true">→</span>
              <span class="font-body text-body-md text-on-surface leading-relaxed">{item}</span>
            </li>
          ))}
        </ul>

        <div class="bg-surface-container border border-outline-variant p-8 space-y-6">
          <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest">[ INFORMACIÓ PRÀCTICA ]</p>
          <div class="space-y-4">
            <div class="flex justify-between items-start border-b border-outline-variant/40 pb-3">
              <span class="font-mono text-code-sm text-on-surface-variant uppercase">Deadline CFP</span>
              <span class="font-mono text-code-sm text-primary-container uppercase">{t('cfp.deadline')}</span>
            </div>
            <div class="flex justify-between items-start border-b border-outline-variant/40 pb-3">
              <span class="font-mono text-code-sm text-on-surface-variant uppercase">Notificació</span>
              <span class="font-mono text-code-sm text-on-surface uppercase">{t('cfp.notification')}</span>
            </div>
            <div class="flex justify-between items-start border-b border-outline-variant/40 pb-3">
              <span class="font-mono text-code-sm text-on-surface-variant uppercase">Data conf</span>
              <span class="font-mono text-code-sm text-on-surface uppercase">{t('hero.date')}</span>
            </div>
            <div class="flex justify-between items-start border-b border-outline-variant/40 pb-3">
              <span class="font-mono text-code-sm text-on-surface-variant uppercase">Idiomes</span>
              <span class="font-mono text-code-sm text-on-surface">CAT / ENG / ESP</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA — SUBMIT TALK
  ═══════════════════════════════════════════════ -->
  <section class="py-24 px-6 bg-surface-container-low relative overflow-hidden border-t border-outline-variant" id="submit">
    <div class="absolute inset-0 terminal-grid opacity-5 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-6">[ EXEC ]</p>
      <h2 class="font-display text-headline-xl uppercase tracking-tighter mb-6 leading-none terminal-cursor">
        {t('cfp.cta')}
      </h2>
      <CTAButton
        href={`mailto:cfp@geekscat.cat?subject=[CFP%202026]%20Proposta%20de%20xerrada&body=T%C3%ADtol%3A%20%0AFormat%3A%20Xerrada%20%2F%20Lightning%20Talk%20%2F%20Taller%0ATrack%3A%20%0ADescripci%C3%B3%3A%20%0A`}
        external
      >
        &gt;_ ENVIA LA TEVA PROPOSTA
      </CTAButton>
      <p class="font-mono text-code-sm text-outline mt-10">
        cfp@geekscat.cat // DEADLINE: {t('cfp.deadline')}
      </p>
    </div>
  </section>

</BaseLayout>
