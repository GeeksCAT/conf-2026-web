---
import BaseLayout from '../../components/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getLocale, useTranslations, localizedPath } from '../../i18n/utils';
export { getStaticPaths } from '../../i18n/utils';

const locale = getLocale(Astro.params.lang);
const t = useTranslations(locale);

const speakersPath = localizedPath('/speakers', locale);
const agendaPath = localizedPath('/agenda', locale);

const topics = [
  {
    index: '1',
    name: t('cfp.topics.opensource'),
    accent: 'primary-container',
    topics: [t('cfp.topics.opensource.1'), t('cfp.topics.opensource.2'), t('cfp.topics.opensource.3'), t('cfp.topics.opensource.4')],
  },
  {
    index: '2',
    name: t('cfp.topics.devops'),
    accent: 'secondary-container',
    topics: [t('cfp.topics.devops.1'), t('cfp.topics.devops.2'), t('cfp.topics.devops.3'), t('cfp.topics.devops.4'), t('cfp.topics.devops.5')],
  },
  {
    index: '3',
    name: t('cfp.topics.aidata'),
    accent: 'primary-fixed-dim',
    topics: [t('cfp.topics.aidata.1'), t('cfp.topics.aidata.2'), t('cfp.topics.aidata.3'), t('cfp.topics.aidata.4')],
  },
  {
    index: '4',
    name: t('cfp.topics.leadership'),
    accent: 'secondary-fixed-dim',
    topics: [t('cfp.topics.leadership.1'), t('cfp.topics.leadership.2')],
  },
] as const;

const formats = [
  { label: t('cfp.formats.talk'), duration: t('cfp.formats.talk.duration'), description: t('cfp.formats.talk.desc') },
  { label: t('cfp.formats.lightning'), duration: t('cfp.formats.lightning.duration'), description: t('cfp.formats.lightning.desc') },
] as const;
---

<BaseLayout
  title={t('cfp.title')}
  description={t('cfp.closed.intro')}
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <header class="relative pt-32 pb-20 px-6 overflow-hidden">
    <div class="absolute inset-0 grid-lines opacity-10 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-5xl mx-auto relative z-10">
      <span class="font-mono text-code-sm text-primary-container uppercase tracking-widest block mb-6 uppercase">
        [ CFP_STATUS: {t('cfp.closed.badge')} ]
      </span>
      <h1 class="font-display uppercase tracking-tighter mb-4 leading-none"
          style="font-size: clamp(2.5rem, 8vw, 5rem)">
        {t('cfp.headline')}
      </h1>
      <p class="font-body text-body-lg text-on-surface-variant mb-8 max-w-2xl">
        {t('cfp.closed.intro')}
      </p>
      <div class="flex flex-wrap gap-4 items-center">
        <span class="font-mono text-code-sm border-2 border-outline text-outline px-5 py-2 uppercase">
          {t('cfp.closed.badge')}
        </span>
        <span class="font-mono text-code-sm border border-primary-container/40 text-primary-container px-5 py-2 uppercase">
          {t('cfp.badge.community')}
        </span>
        <span class="font-mono text-code-sm text-on-surface-variant border border-outline-variant px-5 py-2 uppercase">
          {t('cfp.hero.languages')}
        </span>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════
       RECONEIXEMENT COMUNITARI
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low border-t border-outline-variant" aria-labelledby="present-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader id="present-heading" tag={t('cfp.looking.tag')} title={t('cfp.looking.title')} />

      <div class="grid lg:grid-cols-2 gap-16">
        <div class="space-y-5">
          <p class="font-body text-body-lg text-on-surface leading-relaxed">
            {t('cfp.looking.p1')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('cfp.looking.p2')}
          </p>
        </div>

        <div class="space-y-6">
          <div>
            <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-4">{t('cfp.criteria.tag')}</p>
            <ul class="space-y-3 list-none">
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">{t('cfp.criteria.depth')}</strong> — {t('cfp.criteria.depth.desc')}</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">{t('cfp.criteria.experience')}</strong> — {t('cfp.criteria.experience.desc')}</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">{t('cfp.criteria.culture')}</strong> — {t('cfp.criteria.culture.desc')}</span>
              </li>
              <li class="flex gap-3 items-start">
                <span class="text-primary-container font-mono mt-0.5 shrink-0" aria-hidden="true">→</span>
                <span class="font-body text-body-md text-on-surface-variant"><strong class="text-on-surface font-display uppercase tracking-tight">{t('cfp.criteria.diversity')}</strong> — {t('cfp.criteria.diversity.desc')}</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       FORMATS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6" aria-labelledby="formats-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader id="formats-heading" tag={t('cfp.formats.tag')} title={t('cfp.formats.title')} />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {formats.map(({ label, duration, description }) => (
          <div class="bg-surface-container border border-outline-variant p-8 flex flex-col gap-4">
            <div>
              <p class="font-display text-headline-md uppercase tracking-tight mb-1">{label}</p>
              <span class="font-mono text-code-sm text-primary-container border border-primary-container/30 px-3 py-1 inline-block">
                {duration}
              </span>
            </div>
            <p class="font-body text-body-md text-on-surface-variant leading-relaxed flex-1">{description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       TOPICS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag={t('cfp.topics.tag')} title="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {topics.map(({ index, name, accent, topics }) => (
          <article class={`bg-surface-container border-l-4 border-${accent} p-8`}>
            <p class={`font-mono text-code-sm text-${accent} uppercase tracking-widest mb-4`}>{index}</p>
            <h3 class="font-display text-headline-md uppercase tracking-tight mb-5">{name}</h3>
            <ul class="space-y-2 list-none">
              {topics.map((topic) => (
                <li class="flex gap-3 items-start">
                  <span class={`text-${accent} font-mono text-code-sm mt-0.5 shrink-0`} aria-hidden="true">·</span>
                  <span class="font-body text-body-md text-on-surface-variant">{topic}</span>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>

      <p class="font-body text-body-md text-on-surface-variant mt-8 text-center">
        {t('cfp.topics.footer')}
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       CTA — EXPLORA EL PROGRAMA
  ═══════════════════════════════════════════════ -->
  <section class="py-24 px-6 bg-surface-container relative overflow-hidden border-t border-outline-variant" id="resultat">
    <div class="absolute inset-0 terminal-grid opacity-5 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <p class="font-mono text-code-sm text-outline uppercase tracking-widest mb-6">{t('cfp.closed.tag')}</p>
      <h2 class="font-display text-headline-xl uppercase tracking-tighter mb-6 leading-none">
        {t('cfp.closed.title')}
      </h2>
      <p class="font-body text-body-lg text-on-surface-variant mb-10 max-w-xl mx-auto">
        {t('cfp.closed.desc')}
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CTAButton href={speakersPath}>
          {t('cfp.closed.cta')}
        </CTAButton>
        <CTAButton href={agendaPath} variant="outline">
          {t('cfp.closed.cta.agenda')}
        </CTAButton>
      </div>
    </div>
  </section>

</BaseLayout>
