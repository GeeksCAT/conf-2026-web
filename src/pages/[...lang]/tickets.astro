---
import BaseLayout from '../../components/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import { getLocale, useTranslations } from '../../i18n/utils';
export { getStaticPaths } from '../../i18n/utils';

const locale = getLocale(Astro.params.lang);
const t = useTranslations(locale);

const tiers = [
  {
    name: 'BIOS',
    price: '18€',
    status: t('tickets.tier.bios.status'),
    active: true,
    url: 'https://pretix.eu/geekscat/conf-2026/',
  },
  {
    name: 'KERNEL',
    price: '27€',
    status: t('tickets.tier.kernel.status'),
    active: false,
    url: 'https://pretix.eu/geekscat/conf-2026/',
  },
  {
    name: 'USER SPACE',
    price: '35€',
    status: t('tickets.tier.user-space.status'),
    active: false,
    url: 'https://pretix.eu/geekscat/conf-2026/',
  },
];
---

<BaseLayout
  title={t('tickets.title')}
  description={t('tickets.description')}
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <header class="relative pt-32 pb-20 px-6 overflow-hidden">
    <div class="absolute inset-0 grid-lines opacity-10 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-5xl mx-auto relative z-10">
      <span class="font-mono text-code-sm text-primary-container uppercase tracking-widest block mb-6">
        {t('tickets.badge')}
      </span>
      <h1 class="font-display uppercase tracking-tighter mb-4 leading-none"
          style="font-size: clamp(2.5rem, 8vw, 5rem)">
        {t('tickets.headline')}
      </h1>
      <p class="font-body text-body-lg text-on-surface-variant mb-8 max-w-2xl" set:html={t('tickets.intro')}>
      </p>
      <div class="flex gap-4">
        <CTAButton href="https://geeks.cat/#fes-te-soci" external>{t('tickets.cta.member')}</CTAButton>
      </div>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════
       REGISTRATION TIERS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low border-t border-outline-variant" id="tiers" aria-labelledby="tiers-heading">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {tiers.map(({ name, price, status, active, url }) => (
          <article class={`bg-surface-container border p-8 flex flex-col gap-6 transition-all ${
            active
              ? 'border-primary-container neon-glow'
              : 'border-outline-variant opacity-50'
          }`}>
            <div>
              <h3 class={`font-display text-headline-md uppercase tracking-tight mb-3 ${
                active ? 'text-on-surface' : 'text-on-surface-variant'
              }`}>{name}</h3>
              <p class={`font-mono text-code-lg ${
                active ? 'text-primary-container' : 'text-on-surface-variant'
              }`}>{price}</p>
            </div>
            <div class="mt-auto flex flex-col gap-3">
              <p class="font-mono text-code-xs text-on-surface-variant">
                {status}
              </p>
              {active ? (
                <a
                  href={url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center font-mono font-bold text-sm px-4 py-3 uppercase tracking-tighter transition-colors duration-150 bg-primary-container text-on-primary-container hover:bg-primary-fixed-dim active:translate-y-px"
                >
                  {t('tickets.buy')}
                </a>
              ) : (
                <button
                  disabled
                  class="inline-flex items-center justify-center font-mono font-bold text-sm px-4 py-3 uppercase tracking-tighter border border-outline text-outline opacity-50 cursor-not-allowed"
                >
                  {t('tickets.unavailable')}
                </button>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
