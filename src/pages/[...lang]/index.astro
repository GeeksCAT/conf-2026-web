---
import { getCollection } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getLocale, useTranslations, localizedPath } from '../../i18n/utils';
export { getStaticPaths } from '../../i18n/utils';

const locale = getLocale(Astro.params.lang);
const t = useTranslations(locale);

const agendaPath = localizedPath('/agenda', locale);
const speakersPath = localizedPath('/speakers', locale);
const ticketsPath = localizedPath('/tickets', locale);

// The home shows a teaser of the lineup; the full list lives on /speakers.
const SPEAKER_SLOTS = 8;

const allSpeakers = await getCollection('speakers');
const featuredSpeakers = allSpeakers
  .filter((s) => s.data.locale === locale && !s.data.draft)
  .slice(0, SPEAKER_SLOTS);

const speakerPlaceholderCount = SPEAKER_SLOTS - featuredSpeakers.length;
---

<BaseLayout title="" description="La conferència de geeks per a geeks de Catalunya. 2026.">

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <section class="relative pt-32 pb-24 px-6 overflow-hidden flex flex-col items-center justify-center min-h-dvh">
    <div class="absolute inset-0 grid-lines opacity-10 pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-10 max-w-5xl mx-auto w-full text-center">
      <span class="font-mono text-code-sm text-primary-container uppercase tracking-widest block mb-8">
        {t('hero.badge')}
      </span>

      <h1 class="font-display uppercase tracking-tighter mb-6 leading-none"
          style="font-size: clamp(2.5rem, 8vw, 5rem)">
        GEEKSCAT_CONF_<span class="text-primary-container terminal-cursor">2026</span>
      </h1>

      <p class="font-body text-body-lg text-on-surface-variant mb-2 max-w-xl mx-auto uppercase">
        {t('hero.tagline')}
      </p>

      <p class="font-body text-body-md text-on-surface-variant opacity-70 mb-10 max-w-xl mx-auto">
        {t('hero.leacy_tagline')}
      </p>

      <div class="flex gap-4 justify-center mb-12 flex-wrap" role="list" aria-label="Informació de l'esdeveniment">
        <span role="listitem" class="font-mono text-code-sm border border-outline-variant text-on-surface-variant px-4 py-2">
         {t('hero.date')}
        </span>
        <span role="listitem" class="font-mono text-code-sm border border-outline-variant text-on-surface-variant px-4 py-2">
          <a class="text-primary-container hover:underline" href="https://osm.org/go/xU1FGSMSV?node=4855572478" target="_blank" rel="noopener noreferrer">{t('hero.venue')}</a>
        </span>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CTAButton href={ticketsPath}>{t('hero.cta.ticket')}</CTAButton>
        <CTAButton href={agendaPath} variant="outline">{t('hero.cta.agenda')}</CTAButton>
      </div>
    </div>

    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 font-mono text-code-sm text-on-surface-variant opacity-40 select-none" aria-hidden="true">
      SCROLL_DOWN //
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       01_SOBRE LA CONF
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low" id="sobre" aria-labelledby="sobre-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag={t('index.about.tag')} title={t('index.about.title')} />

      <div class="grid lg:grid-cols-2 gap-16">
        <div class="space-y-5">
          <p class="font-body text-body-lg text-on-surface leading-relaxed">
            {t('index.about.intro')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.about.p1')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.about.p2')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.about.p3')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.about.p4')}
          </p>
        </div>

        <ul class="space-y-4 list-none">
          <li class="border-l-2 border-primary-container pl-6 py-2">
            <p class="font-mono text-code-sm text-primary-container uppercase tracking-wider mb-1">{t('index.about.feature1.tag')}</p>
            <p class="font-display text-headline-md uppercase tracking-tight">{t('index.about.feature1.title')}</p>
            <p class="font-body text-body-md text-on-surface-variant mt-2">{t('index.about.feature1.desc')}</p>
          </li>
          <li class="border-l-2 border-primary-container pl-6 py-2">
            <p class="font-mono text-code-sm text-primary-container uppercase tracking-wider mb-1">{t('index.about.feature2.tag')}</p>
            <p class="font-display text-headline-md uppercase tracking-tight">{t('index.about.feature2.title')}</p>
            <p class="font-body text-body-md text-on-surface-variant mt-2">{t('index.about.feature2.desc')}</p>
          </li>
          <li class="border-l-2 border-primary-container pl-6 py-2">
            <p class="font-mono text-code-sm text-primary-container uppercase tracking-wider mb-1">{t('index.about.feature3.tag')}</p>
            <p class="font-display text-headline-md uppercase tracking-tight">{t('index.about.feature3.title')}</p>
            <p class="font-body text-body-md text-on-surface-variant mt-2">{t('index.about.feature3.desc')}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       BENTO GRID
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6" aria-label="Informació general sobre GeeksCAT Conf">
    <div class="max-w-5xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-4">

        <!-- Historia — col-8 -->
        <article class="md:col-span-8 bg-surface-container border border-outline-variant p-8 relative overflow-hidden" data-watermark="01_HISTORY.LOG">
          <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-4">{t('index.history.tag')}</p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.history.p1')}
          </p>
          <br/>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.history.p2')}
          </p>
          <br/>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.history.p3')}
          </p>
        </article>

        <!-- Activitats — col-4 -->
        <article class="md:col-span-4 bg-surface-container-high border border-primary-container/30 p-8 neon-glow">
          <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-4">{t('index.evolution.tag')}</p>
          <h3 class="font-display text-headline-md tracking-tight mb-6">{t('index.evolution.title')}</h3>
          <div class="mt-6 pt-4 border-t border-outline-variant">
            <span class="font-mono text-xl text-primary-container">{t('index.evolution.footer')}</span>
          </div>
        </article>

        <!-- Missió — col-4 -->
        <article class="md:col-span-4 bg-surface-container border border-outline-variant p-8">
          <p class="font-mono text-code-sm text-secondary-container uppercase tracking-widest mb-4">{t('index.mission.tag')}</p>
          <h3 class="font-display text-headline-md uppercase tracking-tight mb-4">
            {t('index.mission.title')}
          </h3>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.mission.desc')}
          </p>
        </article>

        <!-- Valors — col-8 -->
        <article class="md:col-span-8 bg-surface-container border border-outline-variant p-8 relative overflow-hidden" data-watermark-secondary="VALUES.CFG">
          <p class="font-mono text-code-sm text-secondary-container uppercase tracking-widest mb-4">{t('index.values.tag')}</p>
          <h3 class="font-display text-headline-md uppercase tracking-tight mb-6">{t('index.values.title')}</h3>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div>
              <p class="font-mono text-code-sm text-secondary-container mb-2">{t('index.values.curiosity.tag')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('index.values.curiosity.desc')}</p>
            </div>
            <div>
              <p class="font-mono text-code-sm text-secondary-container mb-2">{t('index.values.sharing.tag')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('index.values.sharing.desc')}</p>
            </div>
            <div>
              <p class="font-mono text-code-sm text-secondary-container mb-2">{t('index.values.community.tag')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('index.values.community.desc')}</p>
            </div>
            <div>
              <p class="font-mono text-code-sm text-secondary-container mb-2">{t('index.values.depth.tag')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('index.values.depth.desc')}</p>
            </div>
          </div>
        </article>

      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       MANIFEST
  ═══════════════════════════════════════════════ -->
  <section class="py-24 px-6 bg-surface-container-low relative overflow-hidden" aria-label="Manifest de GeeksCAT">
    <div class="absolute inset-0 terminal-grid opacity-5 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-4xl mx-auto relative z-10 text-center">
      <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-8">{t('index.manifest.tag')}</p>
      <blockquote class="font-display uppercase tracking-tighter leading-tight mb-8 text-on-surface"
                  style="font-size: clamp(1.5rem, 4vw, 2.5rem)">
        <p class="mb-4">{t('index.manifest.line1')}</p>
        <p class="mb-4">{t('index.manifest.line2')}</p>
        <p class="text-primary-container" set:html={t('index.manifest.line3').replace('\n', '<br/>')}></p>
      </blockquote>
      <p class="font-body text-body-lg text-on-surface-variant max-w-2xl mx-auto leading-relaxed mb-10">
        {t('index.manifest.desc')}
      </p>
      <p class="font-mono text-code-sm text-on-surface-variant opacity-40 select-none" aria-hidden="true">
        // CORE_DUMP COMPLETE <span class="inline-block w-2 h-3 bg-primary-container ml-1 align-middle"></span>
      </p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       02_KEYNOTE SPEAKERS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6" id="ponents" aria-labelledby="speakers-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag={t('index.speakers.tag')} title="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        {featuredSpeakers.map((speaker) => (
          <article class="bg-surface-container border border-outline-variant p-6 flex flex-col">
            <div class="w-full aspect-square bg-surface-container-high border border-outline-variant mb-4 overflow-hidden">
              <img
                src={speaker.data.photo}
                alt={speaker.data.name}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="font-display text-headline-md uppercase tracking-tight leading-tight">{speaker.data.name}</p>
            <p class="font-body text-body-md text-on-surface-variant mt-2 flex-1 text-sm">{speaker.data.role}</p>
          </article>
        ))}

        {Array.from({ length: speakerPlaceholderCount }).map((_, i) => (
          <article class="bg-surface-container border border-outline-variant p-6 flex flex-col" aria-label={`${t('index.speakers.placeholder')} ${featuredSpeakers.length + i + 1}`}>
            <div class="w-full aspect-square bg-surface-container-high border border-outline-variant mb-4" aria-hidden="true"></div>
            <p class="font-mono text-code-sm text-primary-container mb-1">
              PONENT_{String(featuredSpeakers.length + i + 1).padStart(2, '0')}
            </p>
            <p class="font-display text-headline-md uppercase tracking-tight">{t('index.speakers.placeholder')}</p>
            <p class="font-body text-body-md text-on-surface-variant mt-2 flex-1 text-sm">{t('index.speakers.tba')}</p>
            <div class="mt-4 pt-3 border-t border-outline-variant">
              <span class="font-mono text-code-sm text-outline">{t('index.speakers.status')}</span>
            </div>
          </article>
        ))}
      </div>

      <div class="flex justify-center">
        <CTAButton href={speakersPath} variant="outline">{t('index.speakers.cta')}</CTAButton>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       03 _TOPICS
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low" id="topics">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag={t('index.topics.tag')} title="" />

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

        <article class="bg-surface-container border-l-4 border-secondary-container p-8 hover:bg-surface-container-high transition-colors duration-200">
          <p class="font-mono text-code-sm text-secondary-container uppercase tracking-widest mb-4">{t('index.topics.dev.tag')}</p>
          <h3 class="font-display text-headline-md uppercase tracking-tight mb-3">{t('index.topics.dev.title')}</h3>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.topics.dev.desc')}
          </p>
        </article>

        <article class="bg-surface-container border-l-4 border-primary-fixed-dim p-8 hover:bg-surface-container-high transition-colors duration-200">
          <p class="font-mono text-code-sm text-primary-fixed-dim uppercase tracking-widest mb-4">{t('index.topics.workshops.tag')}</p>
          <h3 class="font-display text-headline-md uppercase tracking-tight mb-3">{t('index.topics.workshops.title')}</h3>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.topics.workshops.desc')}
          </p>
        </article>

        <article class="bg-surface-container border-l-4 border-primary-container p-8 hover:bg-surface-container-high transition-colors duration-200">
          <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-4">{t('index.topics.debates.tag')}</p>
          <h3 class="font-display text-headline-md uppercase tracking-tight mb-3">{t('index.topics.debates.title')}</h3>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.topics.debates.desc')}
          </p>
        </article>

        <article class="bg-surface-container border-l-4 border-secondary-fixed-dim p-8 hover:bg-surface-container-high transition-colors duration-200">
          <p class="font-mono text-code-sm text-secondary-fixed-dim uppercase tracking-widest mb-4">{t('index.topics.social.tag')}</p>
          <h3 class="font-display text-headline-md uppercase tracking-tight mb-3">{t('index.topics.social.title')}</h3>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('index.topics.social.desc')}
          </p>
        </article>
      </div>
    </div>
  </section>

  <!-- NOTE: We hide this part because we don't have enough content for this edition, perhaps in a future edition -->
  <!-- ═══════════════════════════════════════════════
       04_EVOLUCIÓ — Timeline
  ═══════════════════════════════════════════════ -->
