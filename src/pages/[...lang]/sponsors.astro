---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../components/BaseLayout.astro';
import CTAButton from '../../components/CTAButton.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import { getLocale, useTranslations } from '../../i18n/utils';
export { getStaticPaths } from '../../i18n/utils';

const locale = getLocale(Astro.params.lang);
const t = useTranslations(locale);

// Load sponsors
const allSponsors = await getCollection('sponsors');
const sponsors = allSponsors
  .filter((s) => s.data.locale === locale && !s.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Pre-render markdown bodies (text after front-matter) for sponsors + collaborators
const sponsorBodies = new Map();
for (const s of sponsors) {
  const { Content } = await render(s);
  sponsorBodies.set(s.id, Content);
}

// Group by tier
const sponsorsByTier = {
  pb: sponsors.filter((s) => s.data.tier === 'pb'),
  tb: sponsors.filter((s) => s.data.tier === 'tb'),
  gb: sponsors.filter((s) => s.data.tier === 'gb'),
  mb: sponsors.filter((s) => s.data.tier === 'mb'),
  collaborator: sponsors.filter((s) => s.data.tier === 'collaborator'),
};

// Define minimum slots per tier (for placeholders)
// Tiers with 0 slots and no sponsors are hidden (title + grid not rendered)
const tierSlots = {
  pb: 1,
  tb: 0,
  gb: 0,
  mb: 0,
} as const;

type TierKey = keyof typeof tierSlots;

// Helper to get items + placeholders
function getItemsWithPlaceholders(items: any[], minSlots: number) {
  const count = Math.max(items.length, minSlots);
  return Array.from({ length: count }, (_, i) => items[i] || null);
}

const tierConfig: Record<
  TierKey,
  {
    label: string;
    titleClass: string;
    borderClass: string;
    hoverClass: string;
    gridClass: string;
    gapClass: string;
    minHeight: string;
    padding: string;
    badgeClass: string;
    tbaClass: string;
    placeholderExtraClass: string;
  }
> = {
  pb: {
    label: '[ PETABYTE ]',
    titleClass: 'text-primary-container',
    borderClass: 'border-2 border-primary-container neon-glow',
    hoverClass: 'hover:border-primary-container',
    gridClass: 'grid grid-cols-1',
    gapClass: 'gap-4',
    minHeight: 'min-h-45',
    padding: 'p-12',
    badgeClass: 'font-mono text-code-sm text-primary-container uppercase tracking-widest mb-2',
    tbaClass: 'font-display text-headline-md text-on-surface-variant uppercase tracking-tight',
    placeholderExtraClass: '',
  },
  tb: {
    label: '[ TERABYTE ]',
    titleClass: 'text-primary-fixed-dim',
    borderClass: 'border border-primary-fixed-dim/40',
    hoverClass: 'hover:border-primary-fixed-dim',
    gridClass: 'grid grid-cols-1 sm:grid-cols-1',
    gapClass: 'gap-4',
    minHeight: 'min-h-35',
    padding: 'p-8',
    badgeClass: 'font-mono text-code-sm text-primary-fixed-dim uppercase tracking-widest mb-1',
    tbaClass: 'font-display text-headline-md text-outline uppercase tracking-tight',
    placeholderExtraClass: 'hover:border-primary-fixed-dim transition-colors duration-200',
  },
  gb: {
    label: '[ GIGABYTE ]',
    titleClass: '',
    borderClass: 'border border-outline-variant',
    hoverClass: 'hover:border-on-surface-variant',
    gridClass: 'grid grid-cols-2 lg:grid-cols-2',
    gapClass: 'gap-4',
    minHeight: 'min-h-30',
    padding: 'p-6',
    badgeClass: 'font-mono text-code-sm text-outline uppercase tracking-widest mb-1',
    tbaClass: 'font-display text-label-md text-outline uppercase tracking-tight',
    placeholderExtraClass: 'hover:border-on-surface-variant transition-colors duration-200',
  },
  mb: {
    label: '[ MEGABYTE ]',
    titleClass: 'text-on-surface-variant',
    borderClass: 'border border-outline-variant/60',
    hoverClass: 'hover:border-outline-variant',
    gridClass: 'grid grid-cols-2 md:grid-cols-3 lg:grid-cols-3',
    gapClass: 'gap-3',
    minHeight: 'min-h-20',
    padding: 'p-4',
    badgeClass: 'font-mono text-code-sm text-outline uppercase tracking-widest text-xs mb-0.5',
    tbaClass: 'font-display text-label-md text-outline uppercase tracking-tight text-xs',
    placeholderExtraClass: 'hover:border-outline-variant transition-colors duration-200',
  },
};

// Only show tiers that have sponsors or reserved slots.
// This prevents rendering empty tier titles for tiers set to 0 in tierSlots.
const visibleTiers = (Object.keys(tierConfig) as TierKey[]).filter(
  (key) => sponsorsByTier[key].length > 0 || tierSlots[key] > 0,
);
---

<BaseLayout
  title={t('sponsors.title')}
  description="Patrocina GeeksCAT Conf 2026, la conferència tècnica de referència de Catalunya."
>

  <!-- ═══════════════════════════════════════════════
       HERO
  ═══════════════════════════════════════════════ -->
  <header class="relative pt-32 pb-16 px-6 border-b border-outline-variant overflow-hidden">
    <div class="absolute inset-0 grid-lines opacity-10 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-5xl mx-auto relative z-10">
      <span class="font-mono text-code-sm text-primary-container uppercase tracking-widest block mb-6">
        {t('sponsors.hero.badge')}
      </span>
      <h1 class="font-display text-headline-xl uppercase tracking-tighter mb-4 leading-none uppercase">
        {t('sponsors.title')}
      </h1>
      <p class="font-body text-body-lg text-on-surface-variant max-w-2xl">
        {t('sponsors.hero.desc')}
      </p>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════════
       TIERS
  ═══════════════════════════════════════════════ -->
  {visibleTiers.length > 0 && (
  <section class="py-20 px-6" aria-labelledby="tiers-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag={t('sponsors.tiers.tag')} title="" />

      <div class="space-y-16">
        {visibleTiers.map((key) => {
          const config = tierConfig[key];
          const items = getItemsWithPlaceholders(sponsorsByTier[key], tierSlots[key]);
          return (
            <div>
              <div class="flex items-baseline gap-4 mb-6">
                <h2 class={`font-display text-headline-lg uppercase tracking-tighter ${config.titleClass}`}>{config.label}</h2>
              </div>
              <div class={`${config.gridClass} ${config.gapClass}`}>
                {items.map((sponsor) => {
                  const SponsorBody = sponsor ? sponsorBodies.get(sponsor.id) : null;
                  const hasBody = !!sponsor?.body?.trim();
                  return sponsor ? (
                    <div class="bg-surface-container border border-outline-variant p-2 flex flex-col gap-2">
                      <a
                        href={sponsor.data.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class={`w-full ${config.borderClass} ${config.padding} flex items-center justify-center ${config.minHeight} bg-surface-container-high ${config.hoverClass} transition-colors duration-200`}
                      >
                        <img
                          src={sponsor.data.logo}
                          alt={sponsor.data.name}
                          width={key === 'pb' ? 289 : 320}
                          height={key === 'pb' ? 181 : 180}
                          loading={key === 'pb' ? 'eager' : 'lazy'}
                          fetchpriority={key === 'pb' ? 'high' : undefined}
                          decoding="async"
                          class="max-w-full max-h-full object-contain"
                        />
                      </a>
                      <div>
                        <p class="font-mono text-code-sm text-on-surface-variant uppercase tracking-widest">{sponsor.data.name}</p>
                        {SponsorBody && hasBody && (
                          <div class="font-body text-body-md text-on-surface-variant mt-3 [&_p]:m-0 [&_a]:underline">
                            <SponsorBody />
                          </div>
                        )}
                      </div>
                    </div>
                  ) : (
                    <div class={`${config.borderClass} ${config.padding} flex items-center justify-center ${config.minHeight} bg-surface-container ${config.placeholderExtraClass}`}>
                      <div class="text-center">
                        <p class={config.badgeClass}>{t('sponsors.tiers.available')}</p>
                        <p class={config.tbaClass} aria-hidden="true">{t('sponsors.tiers.tba')}</p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
  )}

  <!-- ═══════════════════════════════════════════════
       COL·LABORADORS
  ═══════════════════════════════════════════════ -->
  {sponsorsByTier.collaborator.length > 0 && (
    <section class="py-20 px-6 bg-surface-container-low border-t border-outline-variant" aria-labelledby="collaborators-heading">
      <div class="max-w-5xl mx-auto">
        <SectionHeader tag={t('sponsors.collaborators')} title="" />

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {sponsorsByTier.collaborator.map((collaborator) => {
            const CollabBody = sponsorBodies.get(collaborator.id);
            const hasBody = !!collaborator?.body?.trim();
            return (
            <div class="bg-surface-container border border-outline-variant p-2 flex flex-col gap-2 max-w-lg mx-auto">
                <a
                  href={collaborator.data.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full aspect-video border border-outline-variant/60 flex items-center justify-center bg-surface-container-high hover:border-outline transition-colors"
                >
                  <img
                    src={collaborator.data.logo}
                    alt={collaborator.data.name}
                    width={600}
                    height={338}
                    loading="lazy"
                    decoding="async"
                    class="max-w-full max-h-full object-contain p-2"
                  />
              </a>
              <div>
                <p class="font-mono text-code-sm text-on-surface-variant uppercase tracking-widest">{collaborator.data.name}</p>
                {CollabBody && hasBody && (
                  <div class="font-body text-body-md text-on-surface-variant mt-3 [&_p]:m-0 [&_a]:underline">
                    <CollabBody />
                  </div>
                )}
              </div>
            </div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ═══════════════════════════════════════════════
       PITCH / INTRO
  ═══════════════════════════════════════════════ -->
  <section class="py-20 px-6 bg-surface-container-low" aria-labelledby="pitch-heading">
    <div class="max-w-5xl mx-auto">
      <SectionHeader tag={t('sponsors.pitch.tag')} title={t('sponsors.pitch.title')} />

      <div class="grid lg:grid-cols-2 gap-16">
        <div class="space-y-5">
          <p class="font-body text-body-lg text-on-surface leading-relaxed">
            {t('sponsors.pitch.p1')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('sponsors.pitch.p2')}
          </p>
          <p class="font-body text-body-md text-on-surface-variant leading-relaxed">
            {t('sponsors.pitch.p3')}
          </p>
        </div>

        <ul class="space-y-4 list-none">
          <li class="flex gap-4 items-start">
            <span class="text-primary-container font-mono text-code-sm mt-1 shrink-0" aria-hidden="true">→</span>
            <div>
              <p class="font-display text-headline-md uppercase tracking-tight mb-1">{t('sponsors.pitch.visibility.title')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('sponsors.pitch.visibility.desc')}</p>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="text-primary-container font-mono text-code-sm mt-1 shrink-0" aria-hidden="true">→</span>
            <div>
              <p class="font-display text-headline-md uppercase tracking-tight mb-1">{t('sponsors.pitch.talent.title')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('sponsors.pitch.talent.desc')}</p>
            </div>
          </li>
          <li class="flex gap-4 items-start">
            <span class="text-primary-container font-mono text-code-sm mt-1 shrink-0" aria-hidden="true">→</span>
            <div>
              <p class="font-display text-headline-md uppercase tracking-tight mb-1">{t('sponsors.pitch.impact.title')}</p>
              <p class="font-body text-body-md text-on-surface-variant">{t('sponsors.pitch.impact.desc')}</p>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════
       CTA — VOLS SER PATROCINADOR?
  ═══════════════════════════════════════════════ -->
  <section class="py-24 px-6 relative overflow-hidden" id="patrocinar" aria-labelledby="cta-sponsors-heading">
    <div class="absolute inset-0 terminal-grid opacity-5 pointer-events-none" aria-hidden="true"></div>
    <div class="max-w-3xl mx-auto relative z-10 text-center">
      <p class="font-mono text-code-sm text-primary-container uppercase tracking-widest mb-6">{t('sponsors.cta.tag')}</p>
      <h2 id="cta-sponsors-heading" class="font-display text-headline-xl uppercase tracking-tighter mb-6 leading-none">
        {t('sponsors.become')}
      </h2>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <CTAButton href={t('sponsors.dossier.document.url')} external>
          {t('sponsors.cta.dossier')}
        </CTAButton>
        <CTAButton href="mailto:conf@geekscat.org?subject=[PATROCINI|SPONSORING|PATROCINIO%20GeeksCAT%20Conf%202026]" variant="outline" external>
          {t('sponsors.cta.contact')}
        </CTAButton>
      </div>
      <p class="font-mono text-code-sm text-outline mt-10">
        {t('sponsors.cta.email')}
      </p>
    </div>
  </section>

</BaseLayout>
